.playwright-mcp/
.idea/
.DS_Store
.superpowers/
apps/backend/data/
apps/backend/.venv/
__pycache__/
.pytest_cache/
# 슬래시를 붙이면 디렉터리만 무시한다. 심볼릭 링크는 git 에게 파일이라
# 규칙에 걸리지 않고 커밋돼, 체크아웃하는 사람의 node_modules 를 링크로
# 덮어써 사라지게 만들었다(실제로 발생). 슬래시 없이 둔다.
node_modules

# 이음 시드 데이터는 커밋돼야 한다. 전역 gitignore 에 `*.json` 이 있는 개발자는
# 이 예외가 없으면 파일이 조용히 빠지고, clone 한 쪽은 기동할 때 FileNotFoundError 를 만난다.
# 런타임 상태(apps/backend/data/ieum)는 위의 apps/backend/data/ 규칙으로 계속 빠진다.
!apps/backend/app/ieum/data/**/*.json
!docs/ieum/poc/*.json

# 환경변수 — 실제 키가 들어가므로 절대 커밋 금지
.env
.env.local
*.env
!.env.example

# MCP 서버 설정 — Context7 API 키가 평문으로 들어 있어 커밋 금지
.mcp.json

# Terraform — 상태 파일에는 시크릿이 평문으로 남는다
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
tfplan
*.tfplan
crash.log
# .terraform.lock.hcl 은 provider 버전을 고정하므로 커밋한다
