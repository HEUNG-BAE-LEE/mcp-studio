{
  "name": "@mcp-studio/ieum-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "volta": { "node": "24.15.0" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "npm run lint:oxlint && npm run lint:source && npm run lint:tokens && npm run lint:docs",
    "lint:oxlint": "oxlint --report-unused-disable-directives-severity=error",
    "lint:source": "node lint/check-source.js",
    "lint:tokens": "node lint/check-css.js",
    "lint:docs": "node lint/check-docs.js"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "oxlint": "1.75.0",
    "typescript": "6.0.3",
    "vite": "8.1.5"
  }
}
