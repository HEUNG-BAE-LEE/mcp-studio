<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.po.service.impl.VendMapper">

    <!-- 거래처 목록 조회 -->
    <select id="selectVendList" parameterType="egovframework.po.service.VendSearchVO" resultType="egovMap">
        SELECT VEND_CD  AS vendCd
             , VEND_NM  AS vendNm
             , BIZ_NO   AS bizNo
             , TEL_NO   AS telNo
          FROM TB_VEND
         WHERE USE_YN = 'Y'
        <if test="vendNm != null and vendNm != ''">
           AND VEND_NM LIKE '%' || #{vendNm} || '%'
        </if>
         ORDER BY VEND_NM
    </select>

</mapper>
