# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 커밋되지 않는다.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<리소스명>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=<배포 이름>

# 이음 게이트웨이 (모두 선택). 설명은 apps/web/ieum/README.md
# ANTHROPIC_API_KEY=       # 테스트 실행의 자연어 질문, 도구 설명 AI 다시 쓰기
# IEUM_CHAT_MODEL=
# IEUM_SECRET_KEY=         # 원본 시스템 인증 정보 암호화 키. 비우면 data/ieum/.secret_key 를 만든다
