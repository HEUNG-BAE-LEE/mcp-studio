# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 커밋되지 않는다.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<리소스명>.openai.azure.com/
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=<배포 이름>

# 이음 게이트웨이 (모두 선택). 설명은 apps/web/ieum/README.md
# ANTHROPIC_API_KEY=       # 테스트 실행의 자연어 질문, 도구 설명 AI 다시 쓰기
# IEUM_CHAT_MODEL=
# IEUM_SECRET_KEY=         # 원본 시스템 인증 정보 암호화 키. 비우면 data/ieum/.secret_key 를 만든다
# IEUM_LOCAL_REPO_ROOTS=    # 자동 탐색이 폴더 경로로 읽을 상위 폴더들(:로 구분). 비우면 번들 시연용 소스만
# IEUM_MCP_PORTS=8100-8199  # 배포한 MCP 서버(로컬 프로세스)가 쓸 포트 범위
# IEUM_MCP_HOST=127.0.0.1   # 바꾸면 같은 네트워크에 노출된다
# IEUM_MCP_AUTORESTORE=1    # 0 이면 콘솔이 뜰 때 배포 중이던 서버를 다시 띄우지 않는다
